# Секреты и локальная конфигурация
/config/config.php
/config/config.php.tmp
/info.txt

# Загрузки и логи
/uploads/*
!/uploads/.gitkeep
!/uploads/.htaccess
!/uploads/products/
/uploads/products/*
!/uploads/products/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Локальное окружение и служебные файлы
/.tools/
/.DS_Store
*.log
*.tmp
/tests/tmp/
/товар.xlsx

# Локальные скриншоты и PDF
/shots/

# Сборки для загрузки на хостинг
/dist/*

# Ключ прямого доступа к хостингу (не коммитить)
/piz_deploy_key*

# Локальные сборочные зависимости скриншотов
/node_modules/
/package-lock.json
/package.json
/.npm-cache/
/screenshot.js

# Временные файлы проекта — только внутри PIZZA/temp
/temp/*
!/temp/README.md

# Кеш метрик PDF-шрифтов (создаётся tFPDF на сервере)
/src/Lib/tfpdf/font/unifont/*.dat
/src/Lib/tfpdf/font/unifont/*-metrics.php
/src/Lib/tfpdf/font/unifont/*-character-width*.php
